        <mxCell id="query" value="训练后查询：给出空间位置" vertex="1" parent="s5" style="shape=swimlane;horizontal=1;startSize=38;rounded=1;html=0;fillColor=#E8DDF8;swimlaneFillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#1F2937;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;spacing=6;arcSize=6;collapsible=0;">
