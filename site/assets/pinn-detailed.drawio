        <mxCell id="lpde" value="PDE 损失：体积平方加权" vertex="1" parent="s4" style="shape=swimlane;horizontal=1;startSize=38;rounded=1;html=0;fillColor=#D95B57;swimlaneFillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;spacing=6;arcSize=6;collapsible=0;">
          <mxGeometry x="71" y="350" width="445" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lpde-body" value="E_V(r) = Σ(Vᵢ² rᵢ²) / ΣVᵢ²&#10;Lc=E_V(c)，Lx=E_V(rₓ)，Ly=E_V(rᵧ)&#10;Lpde = 107.19669 × 0.333 × (Lc+Lx+Ly)&#10;weightsPDE=1；c、r 的目标为零" vertex="1" parent="lpde" style="shape=text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#1F2937;whiteSpace=wrap;fontSize=14;spacingLeft=10;spacingRight=8;spacingTop=8;">
          <mxGeometry y="38" width="445" height="122" as="geometry" />
        </mxCell>
        <mxCell id="lbc" value="边界损失：面积平方加权" vertex="1" parent="s4" style="shape=swimlane;horizontal=1;startSize=38;rounded=1;html=0;fillColor=#D95B57;swimlaneFillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;spacing=6;arcSize=6;collapsible=0;">
          <mxGeometry x="66" y="98" width="450" height="182" as="geometry" />
        </mxCell>
        <mxCell id="lbc-body" value="E_b(r) = Σ(aᵢ² rᵢ²) / Σaᵢ²，aᵢ=0.05Aᵢ&#10;Lin、Lwall：各 3 项 E_b 之和 × 0.3333&#10;Lout、Lsym：各 2 项 E_b 之和 × 0.5&#10;Lbc=0.21743Lin+0.03371Lwall&#10;       +0.21743Lout+0.5368Lsym；wBD=1" vertex="1" parent="lbc" style="shape=text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#1F2937;whiteSpace=wrap;fontSize=14;spacingLeft=10;spacingRight=8;spacingTop=8;">
