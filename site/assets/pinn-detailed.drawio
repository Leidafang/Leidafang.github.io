        <mxCell id="grad1-body" value="autograd.grad(Y,X)，保留计算图&#10;内部：uₓ,uᵧ,vₓ,vᵧ,pₓ,pᵧ，各 [5616]&#10;边界：读取各自约束所需的一阶导数&#10;对网络函数求导，不作网格差分" vertex="1" parent="grad1" style="shape=text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#1F2937;whiteSpace=wrap;fontSize=14;spacingLeft=10;spacingRight=8;spacingTop=8;">
